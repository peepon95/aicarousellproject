# Secrets — never commit
.env

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Regenerable caches (photos + screenshots are re-fetched on run)
backgrounds/
screenshots/

# Generated web app output. Existing curated examples remain tracked;
# use `git add -f out/<file>` when intentionally adding a new example.
out/*
inbox/
webapp/__pycache__/

# macOS
.DS_Store
