# Copy this file to ".env" and fill in your keys.
# In Vercel, add these under Project Settings > Environment Variables instead.
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.2
# Mixed-source web research can take longer than a normal generation request.
OPENAI_BACKGROUND_MODE=true
OPENAI_TIMEOUT_SECONDS=600
OPENAI_MAX_RETRIES=2

# Get a free Pexels key instantly at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# Optional: a GitHub token raises API rate limits (60/hr -> 5000/hr).
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Telegram carousel agent. Keep all values private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WORKER_REPOSITORY=peepon95/aicarousellproject
GITHUB_DISPATCH_TOKEN=
CRON_SECRET=
TELEGRAM_CAROUSEL_ITEMS=5
TELEGRAM_BACKGROUND_QUERY=warm editorial interiors muted film aesthetic
TELEGRAM_COMMENT_KEYWORD=GUIDE

# Vercel's current Blob connection creates BLOB_STORE_ID automatically and
# injects a short-lived OIDC token into hosted Function requests.
BLOB_STORE_ID=

# Optional legacy/local Blob authentication. New Vercel projects use OIDC.
BLOB_READ_WRITE_TOKEN=
